#!/bin/sh
# Pre-push hook: lint + format + tests must pass before pushing
# Prevents CI failures and wasted GitHub Actions minutes

echo "🔍 Running pre-push checks..."

# Lint
echo "  → ruff check..."
ruff check lexisearch/ tests/ || { echo "❌ Lint failed. Fix with: ruff check --fix ."; exit 1; }

# Format
echo "  → ruff format..."
ruff format --check lexisearch/ tests/ || { echo "❌ Format check failed. Fix with: ruff format ."; exit 1; }

# Tests
echo "  → pytest..."
python -m pytest tests/ -q --tb=line || { echo "❌ Tests failed."; exit 1; }

echo "✅ All checks passed. Pushing..."
